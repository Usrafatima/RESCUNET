# ==============================================================================
# RescueNest Backend Environment Variables Template
# Copy this file to backend/.env and replace placeholders with your credentials.
# ==============================================================================

# Google Gemini API Key (Required for AI agent triage & recommendation analysis)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model ID (Verified supported Flash model)
# Available models: gemini-2.5-flash
GEMINI_MODEL_ID=gemini-2.5-flash

# Backend Base URL (Used by internal agent tools for incident lookup)
BACKEND_URL=http://127.0.0.1:8000

# Edge Gateway Port
EDGE_PORT=8001

# CARTO Map Basemap API Key (Optional public basemap token)
NEXT_PUBLIC_CARTO_API_KEY=your-carto-api-key-here
